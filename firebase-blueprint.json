{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "rating": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "hasVehicleRegistered": { "type": "boolean" },
        "currentEarnings": { "type": "number" },
        "totalDeliveries": { "type": "number" },
        "dailyGoal": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicle information for cost calculation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Moto", "Carro"] },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "averageKmPerLiter": { "type": "number" },
        "fuelType": { "type": "string", "enum": ["Gasolina", "Etanol", "Flex", "Diesel"] },
        "tankCapacityLiters": { "type": "number" },
        "nickname": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "DeliverySession": {
      "title": "Delivery Session",
      "description": "Summary of a completed route.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "totalDeliveries": { "type": "number" },
        "optimizedDistanceKm": { "type": "number" },
        "estimatedNormalDistanceKm": { "type": "number" },
        "totalDistanceKm": { "type": "number" },
        "totalTimeMinutes": { "type": "number" },
        "fuelPricePerLiter": { "type": "number" },
        "estimatedFuelUsedLiters": { "type": "number" },
        "estimatedFuelCost": { "type": "number" },
        "grossEarnings": { "type": "number" },
        "netProfit": { "type": "number" },
        "savedKm": { "type": "number" },
        "savedFuelLiters": { "type": "number" },
        "savedMoney": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Delivery order information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDENTE", "ENTREGUE", "PROBLEMA"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "address", "status"]
    },
    "Earning": {
      "title": "Earning",
      "description": "Record of a completed earning transaction.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deliveryId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "date"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Store individual user profile."
    },
    "deliveries/{deliveryId}": {
      "schema": "Delivery",
      "description": "Store individual delivery orders."
    },
    "earnings/{earningId}": {
      "schema": "Earning",
      "description": "Store individual earning records."
    },
    "vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Store vehicle information."
    },
    "delivery_sessions/{sessionId}": {
      "schema": "DeliverySession",
      "description": "Store end-of-route summary data."
    }
  }
}
